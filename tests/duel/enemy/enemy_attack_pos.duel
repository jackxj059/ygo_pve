# Enemy prototype: attacking an enemy in attack position does not compare its ATK (decided
# 2026-10-06): the enemy loses the attacker's ATK in HP, the attacker is never destroyed and its
# controller takes no damage; at HP 0 the enemy is destroyed by battle. HP 3200 is a TEST VALUE.
start_draw 0 0
start_draw 1 0
draw_per_turn 1 0
card 0 mzone 91152256       # Celtic Guardian 1400 (stronger than the enemy's 1200)
card 0 mzone 15025844       # Mystical Elf 800 (weaker)
card 0 mzone 69247929       # Gene-Warped Warwolf 2000
card 0 mzone 89631139       # Blue-Eyes White Dragon 3000
card 0 deck 15025844 x10
card 1 mzone 990000001 fu_atk

0 idle end
1 idle end
0 idle battle
0 battle attack 91152256    # HP -1400
0 select 990000001
expect hp 990000001 1800 3200
expect count 1 mzone 1
expect lp 0 8000
0 battle attack 15025844    # weaker than the enemy: still HP -800, the Elf survives, no damage
0 select 990000001
expect hp 990000001 1000
expect count 0 mzone 4
expect lp 0 8000
expect destroyed 990000001 not destroyed
0 battle attack 69247929    # 2000 >= HP 1000: destroyed by battle
0 select 990000001
expect hp 990000001 0
expect count 1 mzone 0
expect destroyed 990000001 battle
expect count 0 mzone 4
expect lp 0 8000
stop
