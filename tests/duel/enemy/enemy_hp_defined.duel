# Enemy prototype: an enemy that defines hp uses it; without it HP = printed ATK + DEF.
# 訓練用稻草人 (ATK 500 / DEF 500, hp = 1500) next to 岩殼守衛 (no hp: 1200 + 2000). TEST VALUES.
start_draw 0 0
start_draw 1 0
draw_per_turn 1 0
card 0 mzone 91152256       # Celtic Guardian 1400
card 0 deck 15025844 x10
card 1 mzone 990000002 fu_def
card 1 mzone 990000001 fu_def

expect hp 990000002 1500 1500
expect hp 990000001 3200 3200
0 idle end
1 idle end
0 idle battle
0 battle attack 91152256    # 1400 - DEF 500 = 900
0 select 990000002
expect hp 990000002 600 1500
stop
