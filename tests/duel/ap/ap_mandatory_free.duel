# AP: at 0 AP an optional trigger cannot be activated, but a mandatory trigger (Sangan) still
# resolves. Summons are set to cost 0 here so the setup works at 0 AP. TEST VALUES.
start_draw 0 0
start_draw 1 0
ap 0 0 0
ap_cost 0 activate 1
ap 1 0 0
ap_cost 1 activate 1
ap_cost 1 attack 1
card 0 hand 25259669        # Goblindbergh (optional trigger)
card 0 hand 43096270        # Alexandrite Dragon
card 0 deck 15025844 x5
card 1 hand 26202165        # Sangan (mandatory trigger)
card 1 deck 15025844 x5

0 idle summon 25259669
expect blocked yes 25259669 # optional trigger costs 1, p0 has 0
0 yesno no
0 idle end
1 idle summon 26202165
1 idle end
0 idle summon 43096270
0 idle battle
0 battle attack 43096270
0 select 26202165
1 select 15025844           # Sangan's mandatory trigger resolves with 0 AP
expect ap 1 0
expect count 1 hand 2       # drew 1 on turn 2, summoned Sangan, searched 1
stop
